# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  COPIA este fichero a `.env` y ajusta los valores.
#
#  ⚠ REGLA ABSOLUTA (CONTEXTO.md §2.2):
#  Aquí NUNCA va una clave privada ni una seed phrase. Solo la RUTA al fichero
#  de keypair, que vive FUERA del repositorio.
#  `.env` está en .gitignore. `.env.example` sí se versiona (no tiene secretos).
# ─────────────────────────────────────────────────────────────────────────────

# ── Red ──────────────────────────────────────────────────────────────────────
# Valores admitidos: devnet | mainnet-beta | localnet
# Durante TODO el desarrollo debe ser `devnet`.
CLUSTER=devnet

# RPC opcional. Si se deja vacío se usa el endpoint público del cluster.
# Devnet público: https://api.devnet.solana.com  (gratis, suficiente)
# Mainnet: usar tier gratuito (Helius / QuickNode / Triton). NUNCA hardcodear en código.
RPC_URL=

# ── Claves ───────────────────────────────────────────────────────────────────
# Ruta ABSOLUTA al fichero de keypair (JSON con array de 64 bytes).
# DEBE estar fuera del repositorio. Lo genera `npm run wallet:new`.
#
# Si la dejas VACÍA se usa por defecto  <tu carpeta de usuario>/.solana-memecoin-keys/devnet.json
# que es lo recomendado: así este fichero no revela dónde guardas tus claves.
# Windows: usa barras normales o dobles barras invertidas.
KEYPAIR_PATH=

# ── Guardas de gasto (CONTEXTO.md §2.3 y §4.3) ───────────────────────────────
# Ambas deben valer `true` para que un script pueda gastar en mainnet.
# Además el script pedirá confirmación interactiva escrita. Déjalas en false.
ALLOW_MAINNET=false
I_UNDERSTAND_THIS_SPENDS_REAL_MONEY=false

# ── Metadata del token (§4.5) ────────────────────────────────────────────────
# URL PÚBLICA del JSON de metadata. La genera `npm run metadata:build` y luego
# tienes que subirla (GitHub raw o IPFS). Máximo 200 caracteres (límite Metaplex).
# Ejemplo: https://raw.githubusercontent.com/<usuario>/<repo>/main/assets/metadata.json
METADATA_URI=

# ── Conversión de divisa (solo informativa, para estimaciones) ────────────────
# Se dejan VACÍAS a propósito: no queremos precios inventados de memoria.
# Rellénalas manualmente con la cotización que consultes en el momento.
# Si están vacías, los scripts mostrarán el coste solo en SOL y lo dirán.
SOL_PRICE_USD=
EUR_PER_USD=
